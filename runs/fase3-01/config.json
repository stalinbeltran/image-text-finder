{
  "format_version": 1,
  "data": "C:\\Desarrollo\\image-text-finder\\data\\patch-datasets\\fase3-red",
  "network": {
    "input_size": 40,
    "in_channels": 1,
    "border_features": true,
    "backbone": [
      {
        "filters": 32,
        "kernel": 3,
        "stride": 1,
        "batchnorm": true,
        "activation": "relu",
        "pool": 2
      },
      {
        "filters": 64,
        "kernel": 3,
        "stride": 1,
        "batchnorm": true,
        "activation": "relu",
        "pool": 2
      }
    ],
    "head": {
      "hidden": [
        128
      ],
      "dropout": 0.3
    }
  },
  "recipe": {
    "lr": 0.001,
    "optimizer": "adam",
    "momentum": 0.9,
    "weight_decay": 0.0,
    "batch_size": 64,
    "grad_clip": 0.0,
    "epochs": 20,
    "scheduler": "none",
    "warmup_epochs": 0,
    "patience": 0,
    "min_delta": 0.0,
    "lambda_pos": 1.0,
    "pos_weight": null,
    "smooth_l1_beta": 0.05,
    "monitor": "val_loss",
    "seed": 1
  },
  "execution": {
    "device": "cpu",
    "num_workers": 0
  }
}